# ─── HustleHub+ Environment Configuration ───────────────────────────
# Copy this file to .env and fill in the values before running the app.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=2h

# HTTPS certificate paths (relative to project root)
HTTPS_CERT=certs/server.cert
HTTPS_KEY=certs/server.key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging level: error, warn, info, debug
LOG_LEVEL=info
